{
	"info": {
		"_postman_id": "af78b1c2-d34e-4f5a-8b6c-9d0e1f2a3b4c",
		"name": "FocusUp Bookings & Matching API",
		"description": "Collection to test the Booking and Matching Engine endpoints for FocusUp.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Origin",
								"value": "http://localhost:3001",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"Password123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{authUrl}}/sign-in/email",
							"host": [
								"{{authUrl}}"
							],
							"path": [
								"sign-in",
								"email"
							]
						},
						"description": "Sign in with Better Auth. Sets the focusup.session_token cookie, which Postman then sends to /api/v1. The account must have a verified email to create bookings."
					},
					"response": []
				}
			]
		},
		{
			"name": "Bookings",
			"item": [
				{
					"name": "Create Booking",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"slotTime\": \"2026-04-12T15:00:00.000Z\",\n    \"durationMin\": 50\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings"
							]
						},
						"description": "Create a new booking request. Slot time must be on a 15-minute boundary and at least 5 minutes in the future."
					},
					"response": []
				},
				{
					"name": "List My Bookings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings?page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Retrieve a paginated list of current user's booking requests."
					},
					"response": []
				},
				{
					"name": "Cancel Booking",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "BOOKING_ID_HERE",
									"description": "The ID of the booking request to cancel."
								}
							]
						},
						"description": "Cancel a booking. Reverts partner to PENDING if MATCHED. Increments strike count if late (< 1 hour)."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "authUrl",
			"value": "http://localhost:3000/api/auth",
			"type": "string"
		}
	]
}
