  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
 
  sessionsAsUser1   Session[] @relation("User1Sessions")
  sessionsAsUser2   Session[] @relation("User2Sessions")
  reflections       Reflection[]
  reportsGiven      Report[]  @relation("Reporter")
  reportsReceived   Report[]  @relation("Reported")
  blocks            Block[]   @relation("Blocker")
  blockedBy         Block[]   @relation("Blocked")
}


model Session {
  id              String        @id @default(cuid())
  user1Id         String
  user2Id         String?
  durationMin     Int           // 25 | 50 | 75
  status          SessionStatus @default(PENDING)
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  calcomBookingId String?       @unique
  livekitRoomName String        @unique
  category        Category?
  user1Goal       String?
  user2Goal       String?
 
  user1           User          @relation("User1Sessions", fields: [user1Id], references: [id])
  user2           User?         @relation("User2Sessions", fields: [user2Id], references: [id])
  reflections     Reflection[]
  reports         Report[]
  createdAt       DateTime      @default(now())
}


model Reflection {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  text        String
  rating      Int?     // 1–5 optional self-rating
  createdAt   DateTime @default(now())
}
 
model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  sessionId   String?
  reason      ReportReason
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
}
 
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
}
 
enum SessionStatus { PENDING CONFIRMED ACTIVE COMPLETED CANCELLED NO_SHOW }
enum PlanTier      { FREE PRO TEAM }
enum Category      { CODING WRITING STUDYING DESIGN ADMIN OTHER }
enum ReportReason  { NO_SHOW INAPPROPRIATE HARASSMENT SPAM OTHER }
enum ReportStatus  { OPEN REVIEWED RESOLVED DISMISSED }



6.  User Flows

Flow A — Slot Booking & Auto-Pairing
1.  User opens the booking calendar
2.  User selects a session duration (25 / 50 / 75 min)
3.  User sees available time slots starting every 15 minutes
4.  User chooses a slot and confirms booking
5.  System creates a booking request for that slot
6.  System checks for unmatched users in the same slot and duration
7a. If a compatible unmatched user exists:
      → system pairs both users
      → creates a Session record
      → marks both bookings as matched
      → notifies both users
7b. If no partner is available yet:
      → booking remains PENDING
      → user sees booking as "Waiting for partner" on dashboard
8.  Before session start, matched users receive reminders
9.  At session time → "Join Session" button becomes active
10. Both users enter /session/[id]
11. Live session starts with Goal check-in modal (15s)
12. Timer runs for the selected duration
13. Session ends → Reflection modal
14. Dashboard updates with session result


Flow B — Scheduled Booking (Cal.com)
1.  User visits /schedule (or shares their Cal.com link)
2.  Partner picks a time slot on the Cal.com embed
3.  Cal.com sends BOOKING_CREATED webhook to our API
4.  API creates Session record, links both users
5.  Email confirmation sent to both parties
6.  Dashboard shows upcoming session card with countdown
7.  At session time → "Join Session" button activates
8.  → Continues from step 6 in Flow A


Flow C — Direct Partner Booking
1.  User visits another user's public profile /profile/[username]
2.  User clicks "Book a Focus Session"
3.  User selects an available slot from that user's calendar
4.  System creates a CONFIRMED session between both users directly
5.  Both users receive email confirmation + Google Calendar invite
6.  Dashboard shows upcoming session card with countdown
7.  At session time → "Join Session" button activates
8.  Both users join the live session room
9.  Session ends → Reflection modal + dashboard update



7.  Integration Contracts

Cal.com Integration

Docker Compose Setup
calcom:
  image: calcom/cal.com:latest
  environment:
    DATABASE_URL: ${CALCOM_DATABASE_URL}
    NEXTAUTH_URL: http://calcom:3000
    NEXTAUTH_SECRET: ${CALCOM_SECRET}
    CALENDSO_ENCRYPTION_KEY: ${CALCOM_ENCRYPTION_KEY}
  ports:
    - "3001:3000"


Webhook Payload (BOOKING_CREATED)
interface CalcomWebhookPayload {
  triggerEvent: 'BOOKING_CREATED' | 'BOOKING_CANCELLED' | 'BOOKING_RESCHEDULED';
  payload: {
    uid: string;           // → our calcomBookingId
    startTime: string;     // ISO 8601
    endTime: string;
    duration: number;      // minutes
    organizer: { email: string };
    attendees: Array<{ email: string; name: string }>;
    metadata: { focusCategory?: string };
  };
}


Webhook Handler (NestJS)
@Post('webhooks/calcom')
@UseGuards(CalcomWebhookGuard) // validates X-Cal-Signature-256
async handleCalcomWebhook(@Body() payload: CalcomWebhookPayload) {
  switch (payload.triggerEvent) {
    case 'BOOKING_CREATED':
      return this.sessionsService.createFromCalcom(payload);
    case 'BOOKING_CANCELLED':
      return this.sessionsService.cancelFromCalcom(payload.payload.uid);
    case 'BOOKING_RESCHEDULED':
      return this.sessionsService.rescheduleFromCalcom(payload);
  }
}


