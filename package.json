{
  "name": "focusUp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@orpc/server": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "@types/express": "^5.0.1",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@prisma/client": "^7.2.0",
      "@orpc/client": "^1.12.2",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "typecheck": "turbo check-types",
    "test": "vitest run",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @focusUp/db db:push",
    "db:studio": "turbo -F @focusUp/db db:studio",
    "db:generate": "turbo -F @focusUp/db db:generate",
    "db:migrate": "turbo -F @focusUp/db db:migrate",
    "prepare": "husky"
  },
  "dependencies": {
    "@focusUp/env": "workspace:*",
    "@focusUp/shared-types": "workspace:*",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.1",
    "sanitize-html": "^2.17.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@focusUp/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "packageManager": "bun@1.3.11"
}
