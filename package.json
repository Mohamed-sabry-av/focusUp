{
  "name": "focusUp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@types/express": "^5.0.1",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@prisma/client": "^7.2.0",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "typecheck": "turbo check-types",
    "test": "vitest run",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F api dev",
    "db:studio": "prisma studio --config apps/api/prisma.config.ts",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config apps/api/prisma.config.ts",
    "prepare": "husky && prisma generate --config apps/api/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts"
  },
  "dependencies": {
    "@focusUp/env": "workspace:*",
    "@focusUp/shared-types": "workspace:*",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "better-auth": "^1.7.7",
    "bullmq": "^5.73.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "livekit-server-sdk": "^2.15.1",
    "pg": "^8.17.1",
    "resend": "^6.32.0",
    "sanitize-html": "^2.17.2",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@focusUp/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "packageManager": "bun@1.3.11"
}
