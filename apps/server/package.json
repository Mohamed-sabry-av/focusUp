{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "cd ../.. && bun --hot apps/server/src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@focusUp/api": "workspace:*",
    "@focusUp/db": "workspace:*",
    "@focusUp/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "cors": "^2.8.5",
    "dotenv": "catalog:",
    "express": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@focusUp/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.17",
    "@types/express": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
