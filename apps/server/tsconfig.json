{
  "extends": "@focusUp/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "../api/src/**/*.ts"],
  "exclude": ["../api/src/**/*.test.ts"]
}
