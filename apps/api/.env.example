# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Database (docker compose: postgres on host port 5437)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/focusup

# Redis (BullMQ workers; removed when jobs move to pg-boss)
REDIS_URL=redis://localhost:6379

# Auth (replaced by Better Auth in the next PR)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# LiveKit (dev values from infrastructure/livekit/livekit.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret12345678901234567890123456789012
