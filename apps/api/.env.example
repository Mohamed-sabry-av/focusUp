# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Database (docker compose: postgres on host port 5437)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/focusup

# Redis (BullMQ workers; removed when jobs move to pg-boss)
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
# Required: 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of this API (used for emailed links and the Google redirect URI)
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; enabled only when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without a key, emails are printed in the API log (development only).
# Required when NODE_ENV=production.
RESEND_API_KEY=
EMAIL_FROM="FocusUp <no-reply@localhost>"

# LiveKit (dev values from infrastructure/livekit/livekit.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret12345678901234567890123456789012
