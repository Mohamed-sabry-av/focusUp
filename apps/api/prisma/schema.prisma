generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum SessionStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum Category {
  CODING
  WRITING
  STUDYING
  DESIGN
  ADMIN
  OTHER
}

enum ReportReason {
  NO_SHOW
  INAPPROPRIATE
  HARASSMENT
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum BookingRequestStatus {
  PENDING
  MATCHED
  CANCELLED
  LATE_CANCELLED
  EXPIRED
  NO_SHOW
  SOLO
  COMPLETED
}

enum TaskType {
  DESK
  WALK
  ANY
}

enum StrikeReason {
  NO_SHOW
  LATE_CANCEL
  ADMIN
}

// MODELS

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  displayName     String
  username        String     @unique
  avatarUrl       String?
  timezone        String     @default("UTC")
  categories      Category[]
  preferredLength Int[]      @default([25, 50])

  stripeCustomerId String?
  planTier         PlanTier  @default(FREE)
  suspendedUntil   DateTime?
  hidePhoto        Boolean   @default(false)
  dataSaver        Boolean   @default(false)
  isActive         Boolean   @default(true)
  isBanned         Boolean   @default(false)
  emailVerified    Boolean   @default(false)
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessionsAsUser1       Session[]            @relation("User1Sessions")
  sessionsAsUser2       Session[]            @relation("User2Sessions")
  reflections           Reflection[]
  sessionParticipations SessionParticipant[]
  sessionTasks          SessionTask[]
  reportsGiven          Report[]             @relation("Reporter")
  reportsReceived       Report[]             @relation("Reported")
  blocks                Block[]              @relation("Blocker")
  blockedBy             Block[]              @relation("Blocked")
  bookingRequests       BookingRequest[]
  preferences           UserPreferences?
  authSessions          AuthSession[]
  accounts              Account[]
  strikes               Strike[]
  favorites             Favorite[]           @relation("FavoriteOwner")
  favoritedBy           Favorite[]           @relation("FavoriteTarget")
}

// Better Auth tables. AuthSession is a login session; Session below is a focus session.
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Session {
  id          String        @id @default(cuid())
  user1Id     String
  user2Id     String?
  isSolo      Boolean       @default(false)
  durationMin Int
  status      SessionStatus @default(PENDING)
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  livekitRoomName String    @unique
  category        Category?
  user1Goal       String?
  user2Goal       String?
  createdAt       DateTime  @default(now())

  // Set when the person left on purpose (report, or leaving early).
  endedEarly    Boolean @default(false)
  // Set on the old session when its present person was paired with someone else at T+1.
  rematchedToId String?

  user1           User                 @relation("User1Sessions", fields: [user1Id], references: [id])
  user2           User?                @relation("User2Sessions", fields: [user2Id], references: [id])
  reflections     Reflection[]
  reports         Report[]
  bookingRequests BookingRequest[]
  participants    SessionParticipant[]
  tasks           SessionTask[]

  @@index([status])
  @@index([scheduledAt])
  @@index([user1Id])
  @@index([user2Id])
}

model Reflection {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  text      String
  rating    Int?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reportedId   String
  sessionId    String?
  reason       ReportReason
  description  String?
  // The last chat lines, sent by the reporter's browser (chat is not stored otherwise).
  chatSnapshot Json?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  reporter User     @relation("Reporter", fields: [reporterId], references: [id])
  reported User     @relation("Reported", fields: [reportedId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Favorite {
  userId     String
  favoriteId String
  createdAt  DateTime @default(now())

  user     User @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favorite User @relation("FavoriteTarget", fields: [favoriteId], references: [id], onDelete: Cascade)

  @@id([userId, favoriteId])
  @@index([favoriteId])
}

model Strike {
  id               String       @id @default(cuid())
  userId           String
  bookingRequestId String?
  reason           StrikeReason
  note             String?
  createdAt        DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A booking can only earn one strike per reason, so a retried job cannot strike twice.
  @@unique([bookingRequestId, reason])
  @@index([userId, createdAt])
}

model BookingRequest {
  id          String               @id @default(cuid())
  userId      String
  slotTime    DateTime
  durationMin Int
  status      BookingRequestStatus @default(PENDING)
  sessionId   String?

  // Matching preferences (soft: they order candidates, they never block a match)
  cameraOn        Boolean  @default(true)
  quiet           Boolean  @default(false)
  taskType        TaskType @default(DESK)
  flexible        Boolean  @default(true)
  preferFavorites Boolean  @default(true)
  countsToQuota   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([userId, slotTime])
  @@index([slotTime])
  @@index([status])
  @@index([userId])
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  googleCalendarSync   Boolean  @default(false)
  emailCalendarInvites Boolean  @default(true)
  performanceReports   Boolean  @default(true)
  desktopNotifications Boolean  @default(true)
  quietMode            Boolean  @default(false)
  preferFavorites      Boolean  @default(false)
  timeFormat           String   @default("12h")
  weekStartsOn         String   @default("monday")
  autoRematch          Boolean  @default(false)
  mutedOnJoin          Boolean  @default(false)
  availability         String   @default("everyone")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Who is in the LiveKit room. Written only from signature-verified LiveKit webhooks.
model SessionParticipant {
  id             String    @id @default(cuid())
  sessionId      String
  userId         String
  firstJoinedAt  DateTime?
  lastJoinedAt   DateTime?
  lastLeftAt     DateTime?
  isPresent      Boolean   @default(false)
  // "Keep going" time chosen by this person only (never counts toward quota or strikes).
  extendedUntil  DateTime?
  extensionCount Int       @default(0)
  createdAt      DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
}

model SessionTask {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  text      String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([sessionId, userId])
}
